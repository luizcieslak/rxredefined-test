{
  "name": "kitchen-queue",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w api\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "test": "npm test -w api"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}